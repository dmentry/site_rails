<%= form_with(model: [@article, @article.comments.build], local: true) do |form| %>

  <% if comment.errors.any? %>
    <div id="error_explanation">
      <h2>Ошибки (<%= pluralize(comment.errors.count, "error") %>):</h2>

      <ul>
        <% comment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class='mt-4'>
    <b><%= t('views.comments.add_comment') %></b>
  </div>

  <div class="border mb-2 rounded_corners">
    <div class="m-2">
      <% if !current_user.present? %>
        <div class="form-group">
          <%= form.label t('views.comments.email') %>
          <%= form.text_field :comment_email, class: 'form-control' %>
        </div>
      <% end %>

      <div class="form-group">
        <%= form.label t('views.comments.comment') %>
        <%= form.text_area :comment_body, class: 'form-control' %>
      </div>

      <% if !current_user.present? %>
        <div>
          <%= recaptcha_tags %>
        </div>

        <div class="mt-3 mb-1 form-check">
          <%= check_box_tag :agree_personal_data, 1, false, class: 'form-check-input', id: 'agree_personal_data' %>
          <%= label_tag :agree_personal_data, (t('app.conf_policy.agreed1') + link_to(t('app.conf_policy.agreed2'), conf_policy_path, class: "copyright", target: "_blank", rel: "noreferrer")).html_safe, class: 'form-check-label' %>
        </div>
      <% end %>

      <div class="actions mb-2">
        <%= form.submit t('views.comments.submit'), class: 'btn btn-sm btn-success' %>
      </div>
    </div>
  </div>
<% end %>

<script>
  $(document).ready(function() {
    let $submitButton = $('.actions .btn-success');
    let $agreeCheckbox = $('#agree_personal_data');

    $submitButton.prop('disabled', true);

    $agreeCheckbox.on('change', function() {
      if ($(this).is(':checked')) {
        $submitButton.prop('disabled', false);
      } else {
        $submitButton.prop('disabled', true);
      }
    });
  });
</script>
